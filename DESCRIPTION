Title: Multilevel B-Spline Approximation
Authors@R: c(person("Andrew", "Finley", role=c("aut", "cre"), email="finleya@msu.edu"), person("Sudipto", "Banerjee", role="aut"), person("Øyvind", "Hjelle", role="aut"), person("Roger", "Bivand", role="ctb"))
